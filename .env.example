# Neon Postgres connection string.
# getDb() and pnpm db:seed accept the pooled string (host contains "-pooler").
# pnpm db:migrate and the main-branch migrate workflow open a Postgres session,
# so they need the direct (non-pooler) string. Use the direct string here when
# one variable has to serve both.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Control-plane registry. Leave unset to treat DATABASE_URL as the only tenant
# (local, CI, and today's Neon database).
# CONTROL_DATABASE_URL=postgresql://USER:PASSWORD@HOST/control?sslmode=require

# 32-byte AES-256-GCM key, standard base64. Required to encrypt tenant URLs.
# TENANT_SECRET_KEY=

# Customer database URL for `pnpm tenant:add --url TENANT_DATABASE_URL`.
# Keep the URL here so it stays out of shell history.
# TENANT_DATABASE_URL=

# Optional directory for the local document storage adapter.
# Defaults to .data/documents under the project root.
# DOCUMENT_STORAGE_DIR=

# Attachment bytes. Used when CONTROL_DATABASE_URL is unset, and by
# `pnpm tenant:add --storage local|s3`. Secrets stay in the environment.
# STORAGE_KIND=local
# STORAGE_LOCAL_DIR=./storage
# S3_ENDPOINT=
# S3_REGION=
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=true
# ATTACHMENT_MAX_BYTES=26214400

# Demo data. Leave unset so request failures reach the page.
# NEXT_PUBLIC_DEMO_MODE covers findings and other clients.
# NEXT_PUBLIC_DOCS_DEMO_MODE still turns on Docs demo data by itself.
# NEXT_PUBLIC_DEMO_MODE=true
# NEXT_PUBLIC_DOCS_DEMO_MODE=true

# Organization sent as x-org-id. Unset uses the demo-seed organization.
# TODO(#13): take this from the session once auth exists.
# NEXT_PUBLIC_ORG_ID=10000000-0000-4000-8000-000000000001
